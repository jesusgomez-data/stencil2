# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (correo transaccional — dominio verificado stencil2.com en región EU)
RESEND_API_KEY=
EMAIL_FROM="STENCIL2 <pedidos@stencil2.com>"
EMAIL_ADMIN_TO=pedidos@stencil2.com

# Secreto HMAC-SHA256 para enlaces firmados de baja del newsletter (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://www.stencil2.com
NEXT_PUBLIC_SITE_NAME=STENCIL2

# Cupón de prueba PRUEBA1 (pedido a 1 €). Solo "true" para pruebas; NUNCA en producción.
NEXT_PUBLIC_ENABLE_TEST_PROMO=
